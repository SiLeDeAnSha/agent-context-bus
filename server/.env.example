# Copy to server/.env before running `docker compose up -d`

# 1. Storage & Listening (mount to fnOS shared folder so SMB/App can view Excel directly)
DAILY_MEMORY_DATA_ROOT=/vol1/1000/DailyMemory
DAILY_MEMORY_BIND_HOST=0.0.0.0
DAILY_MEMORY_PORT=8765
TZ=Asia/Shanghai
DAY_START_HOUR=5
MONTHLY_FOLDERS=true
RATE_LIMIT_PER_MIN=180

# 2. Separate Read / Write Bearer Tokens (generate with: openssl rand -hex 32)
# - Company / temporary machines only get DAILY_MEMORY_READ_TOKEN
# - Personal Mac / Windows collectors get DAILY_MEMORY_WRITE_TOKEN (which also grants read)
DAILY_MEMORY_READ_TOKEN=CHANGE_ME_READ_TOKEN_64_HEX
DAILY_MEMORY_WRITE_TOKEN=CHANGE_ME_WRITE_TOKEN_64_HEX

# 3. NAS-side Daily Auto LLM Summarizer (Mode 1A: clients push raw -> NAS fuses & summarizes)
# Supports any OpenAI-compatible /v1/chat/completions endpoint (official, relay, CLIProxyAPI, Ollama)
ENABLE_AUTO_SUMMARIZE=true
SUMMARIZE_CRON_HOUR=9
SUMMARIZE_CRON_MINUTE=5
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
ALLOW_FALLBACK_SUMMARIZE=false

# 4. Optional IPv4 Public Access via Cloudflare Tunnel (docker compose --profile cloudflared up -d)
# In Cloudflare Zero Trust -> Tunnels, point public hostname (e.g. mem.yourdomain.com)
# to Service: http://daily-memory-hub:8765
CLOUDFLARE_TUNNEL_TOKEN=
